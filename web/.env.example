# Local development: the app uses a JSON user store (web/src/lib/user-store.ts)
# and does not need a database, so this can be left as-is.
#
# Production (Vercel): set DATABASE_URL to a hosted PostgreSQL connection string
# (Supabase or Neon). When the value starts with "postgres", the app switches to
# the Prisma schema in web/prisma/schema.prisma for users, sessions, and terms.
# Run `npx prisma db push` once with this value before/after first deploy.
#
# Example:
# DATABASE_URL="postgresql://user:password@host:5432/postgres?sslmode=require"
DATABASE_URL="file:./dev.db"
